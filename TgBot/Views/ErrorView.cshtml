@model System.Exception
@{
    var ex = Model;
}.
<html>
<head>
    <title>Unhandeled Exception</title>
</head>
<body>
    @{
        while (ex != null)
        {
            <h1>@ex.Message</h1><br />
            <i>@ex.StackTrace</i>
            ex = ex.InnerException;
        }
    }
</body>
</html>
