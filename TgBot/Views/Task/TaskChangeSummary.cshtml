    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model TgBot.Controllers.TasksController.TaskChangeSummary
@using TgBot;
@{
    int n;
}
<html>
<head>
    <title>Task Detail</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="https://www.w3schools.com/lib/w3-theme-black.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.3.0/css/font-awesome.min.css">
</head>
<body>
    <header class="w3-container w3-theme w3-padding" id="myHeader">
        <div class="w3-center">
            <h4>Tasks Flow Report<br />From @Model.FromDate to @Model.ToDate</h4>
            <h5>Report generated on @(IntData.toDateString(TGBot.Now(), "MMM dd,yyy HH:mm"))</h5>
        </div>
    </header>
    @if (Model.IncludeIndex)
    {
    <h2>Flow Indexes</h2>
    <div class="w3-container">
        <hr>
        <div class="w3-responsive w3-card-4">
            <table class="w3-table w3-striped w3-bordered">
                <thead>
                    <tr>
                        <th>Index</th>
                        <th>Value</th>
                        <th>Remark</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Completion Index</td>
                        <td>@Model.CompletionIndex</td>
                        <td>Higher is better</td>
                    </tr>
                    <tr>
                        <td>Cancelation Index</td>
                        <td>@Model.CancellationIndex</td>
                        <td>Lower is better (Zero is perfect)</td>
                    </tr>
                    <tr>
                        <td>Task Delay Index</td>
                        <td>@Model.TaskDelayIndex</td>
                        <td>Lower is better (Zero is perfect)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    }
    @foreach (var s in Model.Sections())
    {

        <h2>@s.Title: @s.Tasks.Count</h2>
        <div class="w3-container">
            <hr>
            <div class="w3-responsive w3-card-4">
                <table class="w3-table w3-striped w3-bordered">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Task</th>
                            @if (s.ReportedByColumn != null)
                            {
                                <th>Date</th>
                                <th>@s.ReportedByColumn</th>
                            }
                            <th>Current Status</th>
                            <th>Current Team</th>
                            <th>Last Comment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            n = 1;
                            @foreach (var task in s.Tasks)
                            {
                                <tr>
                                    <td>@(task.Level == 0 ? (n++).ToString() : "")</td>
                                    <td><a href="/task?id=@(task.Task.Id)">@(task.Task.CodeName)</a></td>
                                    @if (s.ReportedByColumn != null)
                                    {
                                        <td>@task.DeltaDate</td>
                                        <td>@task.DeltaBy</td>
                                    }
                                    <td>@(task.StatusString)</td>
                                    <td>@task.WorkingOnIt</td>
                                    <td>
                                        @if (task.LastComment != null)
                                        {
                                            <span>@task.LastComment.Comment<br />By @task.LastComment.Commenter on <i>@task.LastComment.Time</i>  </span>
                                        }
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    @if (Model.IncludeScore)
    {
    <h2>Team Scores</h2>
    <div class="w3-container">
        <hr>
        <div class="w3-responsive w3-card-4">
            <table class="w3-table w3-striped w3-bordered">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Enagagement Score</th>
                        <th>Documentation Score</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.UserContributions)
                    {
                    <tr>
                        <td>@u.User.FullName</td>
                        <td>@u.EngagmentScore</td>
                        <td>@u.DocumentationScore</td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    }
</body>
</html>